/* exp-ruler.js — 钢尺振动：伸出长度 → 振动快慢 → 音调高低 */
(function(){
  'use strict';
  var DW = 640, cv = document.getElementById('rulerCv'), ctx = cv.getContext('2d');
  var W = 640, H = 340, k = 1, lenCm = 20, t0 = performance.now();
  var plucking = false, curAmp = 0, playedSet = new Set(), unlocked = false, audioEl = null;
  function freqFromLen(L){ return Math.round(625 / L); }
  function visualFreq(L){ return 1.8 + 80 / L; }
  function playbackRate(L){ return Math.sqrt(20 / L); }
  function ensureAudio(){ if(!audioEl){ audioEl = document.createElement('audio'); audioEl.src = 'assets/audio/ruler-on-table.mp3'; audioEl.preload = 'auto'; } return audioEl; }
  function resize(){ var f = fitCanvas(cv, getCssH(cv)); ctx = f.ctx; W = f.w; H = parseFloat(cv.style.height) || f.h; k = W / DW; draw(); }
  function draw(){
    var now = (performance.now() - t0) / 1000, freq = visualFreq(lenCm), fHz = freqFromLen(lenCm);
    if(plucking && curAmp > 0){ curAmp *= 0.96; if(curAmp < 0.3){ curAmp = 0; plucking = false; } }
    var phase = now * freq * Math.PI * 2, A = curAmp * k;
    ctx.fillStyle = '#f0efe9'; ctx.fillRect(0, 0, W, H);
    var tableH = H * 0.55, grad = ctx.createLinearGradient(0, tableH, 0, H);
    grad.addColorStop(0, '#e0dccd'); grad.addColorStop(1, '#c9c2ad');
    ctx.fillStyle = grad; ctx.fillRect(0, tableH, W, H - tableH);
    ctx.strokeStyle = '#b5ad99'; ctx.lineWidth = 2 * k;
    ctx.beginPath(); ctx.moveTo(0, tableH); ctx.lineTo(W, tableH); ctx.stroke();
    var rulerW = lenCm * 12 * k, rulerH = 22 * k, edgeX = W * 0.35, rulerY = tableH - rulerH * 0.5;
    ctx.fillStyle = '#f7ddc4'; ctx.strokeStyle = '#d4b08c'; ctx.lineWidth = 1.5 * k;
    roundRectPath(ctx, edgeX - 38 * k, rulerY - 30 * k, 46 * k, 36 * k, 10 * k); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#8a8a8a'; ctx.font = 'bold ' + (11 * k) + 'px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('按住', edgeX - 15 * k, rulerY - 8 * k);
    var tipX = edgeX + rulerW, tipY = rulerY + rulerH * 0.5 + Math.sin(phase) * A;
    ctx.save(); ctx.beginPath();
    ctx.moveTo(edgeX, rulerY);
    ctx.quadraticCurveTo(edgeX + rulerW * 0.5, rulerY + (tipY - (rulerY + rulerH * 0.5)) * 0.5, tipX, tipY);
    ctx.lineTo(tipX, tipY + rulerH * 0.2);
    ctx.quadraticCurveTo(edgeX + rulerW * 0.5, rulerY + rulerH + (tipY - (rulerY + rulerH * 0.5)) * 0.5, edgeX, rulerY + rulerH);
    ctx.closePath();
    var rg = ctx.createLinearGradient(edgeX, rulerY, edgeX, rulerY + rulerH);
    rg.addColorStop(0, '#d4d4d4'); rg.addColorStop(0.5, '#f0f0f0'); rg.addColorStop(1, '#b8b8b8');
    ctx.fillStyle = rg; ctx.fill(); ctx.strokeStyle = '#999'; ctx.lineWidth = 1.2 * k; ctx.stroke();
    ctx.strokeStyle = '#666'; ctx.lineWidth = 1 * k;
    for(var i = 0; i <= lenCm; i++){
      var x = edgeX + i * 12 * k, h = (i % 5 === 0 ? 8 : 4) * k;
      ctx.beginPath(); ctx.moveTo(x, rulerY + 4 * k); ctx.lineTo(x, rulerY + rulerH - 4 * k - h); ctx.stroke();
    }
    ctx.restore();
    ctx.font = 'bold ' + (13 * k) + 'px sans-serif'; ctx.textAlign = 'left'; ctx.fillStyle = '#555';
    ctx.fillText('桌面', 12 * k, tableH - 8 * k);
    ctx.fillText('钢尺伸出 ' + lenCm + ' cm', edgeX + 8 * k, rulerY + rulerH + 24 * k);
    if(curAmp > 0.5){ ctx.fillStyle = '#c0392b'; ctx.fillText('〰 振动中  ' + fHz + ' Hz', edgeX + 8 * k, rulerY + rulerH + 44 * k); }
  }
  var lenSlider = document.getElementById('lenSlider'), lenVal = document.getElementById('lenVal');
  var freqVal = document.getElementById('freqVal'), tryVal = document.getElementById('tryVal');
  var pluckBtn = document.getElementById('pluckBtn'), resetBtn = document.getElementById('resetBtn');
  var findCard = document.getElementById('findCard'), findFb = document.getElementById('findFb');
  var answerBox = document.getElementById('answerBox'), checkBtn = document.getElementById('checkBtn');
  function updateReadout(){ lenCm = +lenSlider.value; lenVal.textContent = lenCm + ' cm'; freqVal.textContent = freqFromLen(lenCm) + ' Hz'; tryVal.textContent = playedSet.size + '/3'; if(playedSet.size >= 3 && !unlocked){ unlocked = true; findCard.style.display = 'block'; } }
  lenSlider.addEventListener('input', function(){ updateReadout(); draw(); });
  pluckBtn.addEventListener('click', function(){ var a = ensureAudio(); a.pause(); a.currentTime = 0; a.playbackRate = playbackRate(lenCm); a.play().catch(function(){}); t0 = performance.now(); plucking = true; curAmp = 18; playedSet.add(lenCm); updateReadout(); });
  resetBtn.addEventListener('click', function(){ playedSet.clear(); unlocked = false; curAmp = 0; plucking = false; findCard.style.display = 'none'; answerBox.style.display = 'none'; findFb.className = 'feedback'; findFb.style.display = 'none'; lenSlider.value = 20; updateReadout(); });
  checkBtn.addEventListener('click', function(){ var w1 = document.getElementById('w1').value, w2 = document.getElementById('w2').value, w3 = document.getElementById('w3').value; if(w1 === '短' && w2 === '快' && w3 === '高'){ findFb.className = 'feedback ok show'; findFb.textContent = '✅ 回答正确！'; answerBox.style.display = 'block'; } else { findFb.className = 'feedback err show'; findFb.textContent = '❌ 再想想：伸出长度、振动快慢、音调高低三者是怎么变化的？'; } });
  function loop(){ draw(); requestAnimationFrame(loop); }
  FullscreenHelper.bind(document.getElementById('fsRulerWrap'), document.getElementById('fsRulerBtn'), resize);
  window.addEventListener('resize', resize); updateReadout(); resize(); requestAnimationFrame(loop);
})();
